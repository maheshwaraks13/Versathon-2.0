# Backend Environment Variables for MedClear
PORT=5000

# LLM Provider Configuration (Supported: claude | openai | gemini)
# Set your API key below. The backend handles calling the LLM API securely.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional explicit provider selection (if multiple keys are set)
LLM_PROVIDER=claude

# Database Configuration (Default: sqlite)
DB_TYPE=sqlite
SQLITE_FILE=medclear.sqlite
