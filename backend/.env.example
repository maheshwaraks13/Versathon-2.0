# ============================================================
# Medical Report Simplifier — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ============================================================

# ----- Database -----
# Default: SQLite (no setup needed for development)
# For production switch to PostgreSQL or Supabase:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./medical_reports.db

# ----- AI Provider -----
# Google Gemini API key (https://ai.google.dev/)
AI_API_KEY=your_gemini_api_key_here

# Gemini model to use for extraction and explanation
AI_MODEL=gemini-3.5-flash

# ----- File Storage -----
# Directory where uploaded files are stored (relative to backend/)
UPLOAD_DIR=uploads

# Maximum allowed file size in megabytes
MAX_FILE_SIZE_MB=20

# ----- CORS Configuration -----
# Comma-separated allowed origins, or * for all (default in development)
# Example: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*
